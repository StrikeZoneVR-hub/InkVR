<Project>
  <Import Project="Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <!-- Override on the command line, with the INKVR_GAME_DIR environment variable, or in an untracked
         Directory.Build.local.props next to this file (<GameDir>...</GameDir> in a PropertyGroup). -->
    <GameDir Condition="'$(GameDir)' == '' and '$(INKVR_GAME_DIR)' != ''">$(INKVR_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Bendy and the Ink Machine</GameDir>
    <GameDir>$([MSBuild]::EnsureTrailingSlash('$(GameDir)'))</GameDir>
    <BepInExDir>$(GameDir)BepInEx\</BepInExDir>
  </PropertyGroup>
</Project>
